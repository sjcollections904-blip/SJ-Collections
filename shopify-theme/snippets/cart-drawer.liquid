{% comment %}
  Slide-out Luxury Shopping Bag Drawer
{% endcomment %}

<div id="CartDrawer" class="cart-drawer" aria-hidden="true">
  <div class="cart-drawer__backdrop" data-drawer-close></div>
  <div class="cart-drawer__panel">
    <!-- Header -->
    <div style="padding: 1.5rem; border-bottom: 1px solid var(--color-border-ivory); display: flex; align-items: center; justify-content: space-between;">
      <h3 style="font-family: var(--font-serif); font-size: 1.35rem; font-weight: 500;">
        Your Shopping Bag
      </h3>
      <button type="button" data-drawer-close class="header-icon-btn" aria-label="Close Shopping Bag">
        {% render 'icon-close' %}
      </button>
    </div>

    <!-- Items List (dynamic via theme.js) -->
    <div style="flex: 1 1 0%; overflow-y: auto; padding: 1rem 1.5rem;" data-cart-drawer-items>
      <!-- Rendered dynamically by window.SJCart.render -->
    </div>

    <!-- Footer Summary -->
    <div style="padding: 1.5rem; border-top: 1px solid var(--color-border-ivory); background-color: var(--color-ivory);">
      <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem; font-size: 0.875rem;">
        <span style="color: var(--color-warm-grey); text-transform: uppercase; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em;">Subtotal</span>
        <span style="font-size: 1.15rem; font-weight: 700; color: var(--color-soft-black);" data-cart-drawer-subtotal>
          {{ cart.total_price | money }}
        </span>
      </div>

      <p style="font-size: 0.7rem; color: var(--color-warm-grey); margin-bottom: 1.25rem; line-height: 1.4;">
        Complimentary White-Glove Tracked Delivery across Pakistan · Cash on Delivery (COD) Only
      </p>

      <a href="/cart" class="btn btn-primary" style="width: 100%; margin-bottom: 0.5rem;">
        PROCEED TO CASH ON DELIVERY
      </a>

      <button type="button" data-drawer-close class="btn btn-secondary" style="width: 100%; border: none; font-size: 0.6875rem; padding: 0.5rem;">
        Continue Exploring Creations
      </button>
    </div>
  </div>
</div>
