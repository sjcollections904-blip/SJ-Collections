<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#1A1A1A">
    <link rel="canonical" href="{{ canonical_url }}">

    <!-- Favicon -->
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'social-meta-tags' %}

    <!-- Google Fonts & Theme Stylesheet -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <!-- Required Shopify Header Content -->
    {{ content_for_header }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.SJ_THEME = {
        whatsappNumber: {{ settings.whatsapp_number | default: '923333368420' | json }},
        shippingFee: {{ settings.shipping_fee | default: 0 | json }},
        moneyFormat: {{ shop.money_format | json }}
      };
    </script>
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-to-content-link" href="#MainContent" style="position: absolute; left: -9999px; z-index: 999; padding: 1rem; background: #000; color: #FFF;">
      Skip to content
    </a>

    <!-- Top Announcement Bar -->
    {% section 'announcement-bar' %}

    <!-- Centered Luxury Header -->
    {% section 'header' %}

    <!-- Main Content Layout -->
    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- Global Luxury Footer -->
    {% section 'footer' %}

    <!-- Slide-out Shopping Bag Drawer -->
    {% render 'cart-drawer' %}

    <!-- Floating WhatsApp Concierge -->
    {% render 'floating-whatsapp' %}

    <!-- Theme JavaScript -->
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
