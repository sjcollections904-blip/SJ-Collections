{% comment %}
  Official Main Collection Template
{% endcomment %}

{%- paginate collection.products by section.settings.products_per_page -%}
  <section style="padding: 3rem 0 5rem;">
    <div class="page-container">
      
      <!-- Collection Header -->
      <div style="text-align: center; max-width: 700px; margin: 0 auto 3.5rem;">
        <span style="font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-warm-grey); display: block; margin-bottom: 0.5rem;">
          ATELIER COLLECTION
        </span>
        <h1 style="font-size: 2.75rem; font-weight: 400; color: var(--color-soft-black); margin-bottom: 0.75rem;">
          {{ collection.title }}
        </h1>
        {%- if collection.description != blank -%}
          <p style="font-size: 0.9375rem; color: #666; line-height: 1.6;">
            {{ collection.description }}
          </p>
        {%- endif -%}
        <p style="font-size: 0.75rem; color: var(--color-warm-grey); margin-top: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em;">
          {{ collection.products_count }} {{ collection.products_count | pluralize: 'Creation', 'Creations' }}
        </p>
      </div>

      <!-- Product Grid -->
      <div class="product-grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product_card_product: product %}
        {%- else -%}
          <div style="grid-column: 1 / -1; text-align: center; padding: 4rem 1rem; color: var(--color-warm-grey);">
            <p style="font-size: 1rem; margin-bottom: 1.5rem;">No creations found in this collection.</p>
            <a href="/collections/all" class="btn btn-secondary">
              Explore All Collections
            </a>
          </div>
        {%- endfor -%}
      </div>

      <!-- Pagination -->
      {%- if paginate.pages > 1 -%}
        {% render 'pagination', paginate: paginate %}
      {%- endif -%}

    </div>
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection Grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "default": 12,
      "label": "Products per page"
    }
  ]
}
{% endschema %}
