{% comment %}
  Official Static Page Template (About, Contact, Policies, FAQ)
{% endcomment %}

<section style="padding: 4rem 0 6rem;">
  <div class="page-container" style="max-width: 840px;">
    <div style="text-align: center; margin-bottom: 3rem; border-bottom: 1px solid var(--color-border-ivory); padding-bottom: 2rem;">
      <span style="font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-warm-grey); display: block; margin-bottom: 0.5rem;">
        SJ COLLECTIONS ATELIER
      </span>
      <h1 style="font-size: 2.75rem; font-weight: 400; color: var(--color-soft-black);">
        {{ page.title }}
      </h1>
    </div>

    <div class="page-content" style="font-size: 0.9375rem; line-height: 1.8; color: #4A4843;">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page Content",
  "settings": []
}
{% endschema %}
