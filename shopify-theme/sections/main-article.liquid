<article class="page-container py-12">
  <div class="max-w-3xl mx-auto">
    <p class="text-xs font-semibold tracking-widest uppercase text-[#8A8882] mb-2 text-center">{{ article.published_at | date: "%B %d, %Y" }}</p>
    <h1 class="font-serif-luxury text-3xl sm:text-5xl text-[#1A1A1A] text-center mb-6">{{ article.title }}</h1>
    {% if article.image %}
      <div class="aspect-[16/9] overflow-hidden mb-8">
        <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.image.alt | default: article.title }}" class="w-full h-full object-cover">
      </div>
    {% endif %}
    <div class="prose max-w-none text-base leading-relaxed text-[#1A1A1A]">
      {{ article.content }}
    </div>
  </div>
</article>

{% schema %}
{
  "name": "Article Content",
  "settings": []
}
{% endschema %}
