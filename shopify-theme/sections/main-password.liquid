<div class="min-h-screen flex items-center justify-center bg-[#F9F8F4] px-4 py-16">
  <div class="max-w-md w-full bg-white p-8 border border-[#E8E5DE] text-center">
    <img src="{{ 'sj-logo.svg' | asset_url }}" alt="SJ Collections" class="h-10 mx-auto mb-6 object-contain">
    <h1 class="font-serif-luxury text-2xl text-[#1A1A1A] mb-2">Opening Soon</h1>
    <p class="text-xs text-[#8A8882] uppercase tracking-wider mb-6">Private Atelier In Preparation</p>

    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <div class="mb-4">
        <input
          type="password"
          name="password"
          id="Password"
          class="form-control text-center"
          placeholder="Enter store password"
          required
        >
      </div>
      <button type="submit" class="btn btn-primary w-full text-xs uppercase tracking-widest py-3">
        Enter Atelier
      </button>
    {% endform %}

    <div class="mt-8 pt-6 border-t border-[#E8E5DE] text-xs text-[#8A8882]">
      <span>Direct Concierge: </span>
      <a href="https://wa.me/{{ settings.whatsapp_number | default: '923333368420' }}" class="text-[#1A1A1A] font-semibold underline">
        WhatsApp VIP
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password Page",
  "settings": []
}
{% endschema %}
