{% comment %}
  Official 404 Luxury Not Found Template
{% endcomment %}

<section style="padding: 6rem 0 8rem; text-align: center;">
  <div class="page-container" style="max-width: 550px;">
    <span style="font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-warm-grey); display: block; margin-bottom: 0.5rem;">
      PAGE UNREACHABLE
    </span>
    <h1 style="font-size: 3.5rem; font-weight: 400; color: var(--color-soft-black); margin-bottom: 1rem;">
      404
    </h1>
    <p style="font-size: 0.95rem; color: #666; line-height: 1.6; margin-bottom: 2rem;">
      The creation or editorial page you sought does not exist or has been relocated within our atelier.
    </p>
    <a href="/" class="btn btn-primary">
      RETURN TO ATELIER HOME
    </a>
  </div>
</section>

{% schema %}
{
  "name": "404 Page",
  "settings": []
}
{% endschema %}
