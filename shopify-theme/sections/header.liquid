{% comment %}
  Official SJ Collections Centered Header
{% endcomment %}

<header class="site-header">
  <div class="page-container">
    <div class="site-header__wrapper">
      <!-- Left: Mobile Menu Toggle & Desktop Navigation -->
      <div class="site-header__left">
        <button type="button" class="mobile-menu-toggle" data-mobile-menu-toggle aria-label="Open Navigation Menu">
          <span></span>
          <span></span>
          <span></span>
        </button>

        <nav class="site-nav" role="navigation">
          {%- for link in linklists[section.settings.menu].links -%}
            <a
              href="{{ link.url }}"
              class="site-nav__link{% if link.active %} site-nav__link--active{% endif %}"
            >
              {{ link.title }}
            </a>
          {%- else -%}
            <!-- Default Luxury Fallback Links if no menu created in Shopify admin yet -->
            <a href="/collections/all" class="site-nav__link">Catalog</a>
            <a href="/collections/men" class="site-nav__link">Men</a>
            <a href="/collections/women" class="site-nav__link">Women</a>
            <a href="/collections/wallets" class="site-nav__link">Wallets</a>
            <a href="/collections/footwear" class="site-nav__link">Footwear</a>
          {%- endfor -%}
        </nav>
      </div>

      <!-- Center: Official SJ Collections Logo (Strictly Centered) -->
      <div class="site-header__logo-container">
        <a href="/" class="site-header__logo-link" aria-label="{{ shop.name }}">
          {%- if section.settings.logo != blank -%}
            <img
              src="{{ section.settings.logo | image_url: width: 400 }}"
              alt="{{ section.settings.logo.alt | default: shop.name }}"
              class="site-header__logo-img"
              style="max-width: {{ section.settings.logo_width }}px;"
              width="{{ section.settings.logo_width }}"
              height="60"
            >
          {%- else -%}
            <!-- Official Vector SVG Logo Asset -->
            <img
              src="{{ 'sj-logo.svg' | asset_url }}"
              alt="SJ Collections"
              class="site-header__logo-img"
              style="max-width: {{ section.settings.logo_width }}px;"
              width="{{ section.settings.logo_width }}"
              height="60"
            >
          {%- endif -%}
        </a>
      </div>

      <!-- Right: Search & Shopping Bag -->
      <div class="site-header__right">
        <a href="/search" class="header-icon-btn" aria-label="Search collections" title="Search">
          {% render 'icon-search' %}
        </a>

        <button
          type="button"
          class="header-icon-btn"
          data-cart-drawer-open
          aria-label="Shopping Bag"
          title="Shopping Bag"
        >
          {% render 'icon-bag' %}
          <span class="header-cart-badge" data-cart-count style="{% if cart.item_count == 0 %}display: none;{% endif %}">
            {{ cart.item_count }}
          </span>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div id="MobileDrawer" class="mobile-drawer" aria-hidden="true">
  <div class="mobile-drawer__backdrop"></div>
  <div class="mobile-drawer__panel">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
      <span style="font-size: 0.75rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase;">
        SJ Navigation
      </span>
      <button type="button" data-drawer-close class="header-icon-btn" aria-label="Close Navigation">
        {% render 'icon-close' %}
      </button>
    </div>

    <nav style="display: flex; flex-direction: column; gap: 1.25rem;">
      {%- for link in linklists[section.settings.menu].links -%}
        <a
          href="{{ link.url }}"
          style="font-size: 0.95rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-soft-black);"
        >
          {{ link.title }}
        </a>
      {%- else -%}
        <a href="/collections/all" style="font-size: 0.95rem; font-weight: 600; text-transform: uppercase;">All Creations</a>
        <a href="/collections/men" style="font-size: 0.95rem; font-weight: 600; text-transform: uppercase;">Men's Collection</a>
        <a href="/collections/women" style="font-size: 0.95rem; font-weight: 600; text-transform: uppercase;">Women's Collection</a>
        <a href="/collections/wallets" style="font-size: 0.95rem; font-weight: 600; text-transform: uppercase;">Leather Wallets</a>
        <a href="/collections/footwear" style="font-size: 0.95rem; font-weight: 600; text-transform: uppercase;">Luxury Footwear</a>
      {%- endfor -%}
    </nav>

    <div style="margin-top: auto; padding-top: 2rem; border-top: 1px solid var(--color-border-ivory);">
      <p style="font-size: 0.75rem; color: var(--color-warm-grey); margin-bottom: 0.75rem;">
        Direct WhatsApp Atelier Concierge:
      </p>
      {%- if settings.whatsapp_number != blank -%}
        <a
          href="https://wa.me/{{ settings.whatsapp_number | escape }}"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp"
          style="width: 100%; font-size: 0.75rem;"
        >
          {% render 'icon-whatsapp' %}
          <span>{{ settings.whatsapp_label | default: '+92 333 3368420' }}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 120,
      "max": 300,
      "step": 10,
      "default": 190,
      "unit": "px",
      "label": "Logo Max Width"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
